# ==============================================================================
# Customer Churn Intelligence & Retention Optimization Platform
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
APP_NAME="Telco Churn Intelligence Platform"
LOG_LEVEL=INFO

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=True
API_SECRET_KEY=change-me-in-production-super-secret-key-32chars

# Streamlit Dashboard Configuration
DASHBOARD_PORT=8501
DASHBOARD_HOST=127.0.0.1

# PostgreSQL Database Configuration
# Local Windows Service default or Docker container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telco_churn_db

# SQLite Fallback / Test Database URL
# If PostgreSQL is unavailable or during headless testing, system can use SQLite
SQLITE_DB_PATH=data/telco_churn.db
USE_SQLITE_FALLBACK=False

# Data Sources
DATA_RAW_URL=https://raw.githubusercontent.com/IBM/telco-customer-churn-on-icp4d/master/data/Telco-Customer-Churn.csv
DATA_RAW_PATH=data/raw/Telco-Customer-Churn.csv
DATA_PROCESSED_PATH=data/processed/telco_churn_clean.parquet

# Model & Artifact Paths
MODEL_ARTIFACTS_DIR=artifacts/models
METRICS_ARTIFACTS_DIR=artifacts/metrics
EXPLAINERS_ARTIFACTS_DIR=artifacts/explainers
ACTIVE_MODEL_PATH=artifacts/models/calibrated_xgb_pipeline.joblib

# Business Retention Simulator Defaults
DEFAULT_CAMPAIGN_BUDGET=50000.0
DEFAULT_OFFER_COST=35.0
DEFAULT_SAVE_RATE=0.22
DEFAULT_HORIZON_MONTHS=12
